{
  "description": "Hallway: show each new session who else is running, and remember what each session is working on.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/hallway.py\" hook-start",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/hallway.py\" note",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  }
}
